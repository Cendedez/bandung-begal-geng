# Twitter / X API Key
# Dapatkan token ini dari: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN="your_twitter_bearer_token_here"

# Local PostGIS database used by the FastAPI service.
DATABASE_URL="postgresql://bandung_crime:bandung_crime_dev@localhost:5434/bandung_crime"
# Comma-separated public frontend origins. Do not use * in production.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Internal Streamlit moderator access. Use a long, unique value in production.
MODERATOR_PASSWORD="replace-with-a-strong-password"
MODERATOR_NAME="Moderator Bandung Aman"

# Canonical citizen reporting form served by the PWA.
PWA_REPORT_URL="http://127.0.0.1:3000/lapor"
